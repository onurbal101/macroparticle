{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv/current
	encode zstd gzip
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header Cache-Control "no-cache"
	@trailingSlash path_regexp trailingSlash ^(.+)/$
	redir @trailingSlash {re.trailingSlash.1}?{query} 308

	@oldControls path_regexp oldControls ^/(?:controls|guide/controls)(/.*)?$
	redir @oldControls /simulation{re.oldControls.1} 308
	redir /favorites /account/favorites 308
	@personal path /account* /search /app.html
	header @personal X-Robots-Tag "noindex, follow"

	@hashedAsset {
		path /assets/*
		file
	}
	handle @hashedAsset {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@static path /assets/* /icons/* /social/* /content/* /print/* /favicon.ico /favicon.svg /robots.txt /sitemap.xml /llms.txt /app.html /sw.js /workbox-*.js /manifest.webmanifest
	handle @static {
		header Cache-Control "no-cache"
		file_server
	}

	handle / {
		rewrite * /index.html
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}.html =404
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
