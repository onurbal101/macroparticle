{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv/current
	encode zstd gzip
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin

	@hashedAsset {
		path /assets/*
		file
	}
	handle @hashedAsset {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@static path /assets/* /icons/* /print/* /sw.js /workbox-*.js /manifest.webmanifest
	handle @static {
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
